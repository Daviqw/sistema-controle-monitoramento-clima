# Copie para .env e substitua todos os segredos de exemplo.
SPRING_PROFILES_ACTIVE=prod
DB_NAME=clima
DB_USER=clima_app
DB_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-bytes
JWT_EXPIRATION=3600000
FRONTEND_ORIGIN=http://localhost:4200
# Deve corresponder à chave local no frontend; apenas desenvolvimento.
FRONTEND_SHARED_KEY=dev-only-frontend-key
SERVER_PORT=8080
ADMIN_INITIAL_EMAIL=admin@clima.local
ADMIN_INITIAL_PASSWORD=troque-por-uma-senha-forte
